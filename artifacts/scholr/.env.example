# Base URL of the API server deployed on Render (no trailing slash).
# Required on Vercel — without it the SPA calls its own origin and every
# /api/* request 404s.
VITE_API_BASE_URL=https://scholarship-api.onrender.com

# Optional client retry tuning
VITE_API_MAX_RETRIES=3
VITE_API_RETRY_DELAY_MS=5000

# Auth0 (only if used)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
