# Supabase (optional — used by frontend)
SUPABASE_URL=https://oefiyaqzkjubcndjzyke.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Auth0 (optional — social sign-in)
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_APP_DOMAIN=your_app_domain.com

# JWT (required — used to sign/verify auth tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_random_64_byte_hex_secret

# App
PORT=3001
NODE_ENV=development
